; Engine configuration file.
; Compatible with Godot 4.3+ and Xogot (Godot 4.4–4.6 on iPhone/iPad).
config_version=5

[application]
config/name="Bloodbound Summoner"
config/description="2D action RPG + academy life sim. A summoner who cannot summon forms pacts instead."
config/version="0.1.0"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]
GameState="*res://scripts/autoload/game_state.gd"
Dice="*res://scripts/autoload/dice.gd"
PactSystem="*res://scripts/autoload/pact_system.gd"
Relationships="*res://scripts/autoload/relationship_system.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
StoryDB="*res://scripts/autoload/story_db.gd"
Campaign="*res://scripts/autoload/campaign.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

