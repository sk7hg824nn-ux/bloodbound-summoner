; Engine configuration file.
; Xogot iPhone target: Godot 4.6.
config_version=5

[application]
config/name="Bloodbound Summoner"
config/description="Illustrated 2.5D. Landscape mobile. Player brick."
config/version="0.4.0"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]
GameState="*res://scripts/autoload/game_state.gd"
Dice="*res://scripts/autoload/dice.gd"
PactSystem="*res://scripts/autoload/pact_system.gd"
Relationships="*res://scripts/autoload/relationship_system.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
StoryDB="*res://scripts/autoload/story_db.gd"
Campaign="*res://scripts/autoload/campaign.gd"
Bricks="*res://scripts/autoload/bricks.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"

[display]
window/size/viewport_width=844
window/size/viewport_height=390
window/size/window_width_override=844
window/size/window_height_override=390
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input]
move_left={"deadzone":0.2,"events":[]}
move_right={"deadzone":0.2,"events":[]}
move_up={"deadzone":0.2,"events":[]}
move_down={"deadzone":0.2,"events":[]}
attack={"deadzone":0.5,"events":[]}
dodge={"deadzone":0.5,"events":[]}
ability={"deadzone":0.5,"events":[]}
interact={"deadzone":0.5,"events":[]}

[input_devices]
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[layer_names]
2d_physics/layer_1="player"
2d_physics/layer_2="world"
2d_physics/layer_3="companions"
2d_physics/layer_4="enemies"
2d_physics/layer_5="interact"
2d_physics/layer_6="hitbox"

[rendering]
renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.12, 0.11, 0.16, 1)
